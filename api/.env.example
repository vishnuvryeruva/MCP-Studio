NODE_ENV=development
PORT=3000

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=mygo_fm_bridge

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

# AES-256-GCM key (32 bytes hex) used to encrypt SAP credentials at rest
CREDENTIALS_ENCRYPTION_KEY=change-me-64-hex-chars

CORS_ORIGIN=http://localhost:5173
