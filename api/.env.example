NODE_ENV=development
PORT=3000

# Postgres (local dev only; on Cloud Foundry credentials come from the bound
# postgresql-db service via VCAP_SERVICES)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=mygo_fm_bridge
# Optional dedicated schema — set when sharing a Postgres instance with another app.
DB_SCHEMA=

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

# AES-256-GCM key (32 bytes hex) used to encrypt SAP credentials at rest
CREDENTIALS_ENCRYPTION_KEY=change-me-64-hex-chars

# Default SAP Cloud Connector Location ID for reaching the on-prem ABAP system.
# Find it in the BTP Cockpit > Connectivity > Cloud Connectors (e.g. MYGO-BTP-BAS).
# Only used when running on Cloud Foundry with the connectivity + xsuaa services bound.
SAP_CLOUD_CONNECTOR_LOCATION_ID=

CORS_ORIGIN=http://localhost:5173
