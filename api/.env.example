NODE_ENV=development
PORT=3000

# Postgres (local dev only; on Cloud Foundry credentials come from the bound
# postgresql-db service via VCAP_SERVICES)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=mygo_fm_bridge
# Optional dedicated schema — set when sharing a Postgres instance with another app.
DB_SCHEMA=

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

# AES-256-GCM key (32 bytes hex) used to encrypt SAP credentials at rest
CREDENTIALS_ENCRYPTION_KEY=change-me-64-hex-chars

# Default SAP Cloud Connector Location ID for reaching the on-prem ABAP system.
# Find it in the BTP Cockpit > Connectivity > Cloud Connectors (e.g. MYGO-BTP-BAS).
# Only used when running on Cloud Foundry with the connectivity + xsuaa services bound.
SAP_CLOUD_CONNECTOR_LOCATION_ID=

CORS_ORIGIN=http://localhost:5173

# --- LLM ---
# Active vendor: anthropic | openai | gemini. Only the selected one needs a key.
LLM_PROVIDER=anthropic
LLM_MAX_TOKENS=16000
# Anthropic-only thinking depth / spend: low | medium | high
LLM_EFFORT=medium
# Max tool-call rounds per chat turn, and truncation cap for SAP payloads.
LLM_MAX_TOOL_ITERATIONS=5
LLM_MAX_TOOL_RESULT_CHARS=20000

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Optional: override the API host (proxy or local mock). Leave blank for the real API.
ANTHROPIC_BASE_URL=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
